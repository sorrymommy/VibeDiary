<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System splash (Android 12+): paper ground + the V 노선 mark, so the in-app
         launch screen that adds the tagline continues it without a colour jump. -->
    <style name="Theme.VibeDiary" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
